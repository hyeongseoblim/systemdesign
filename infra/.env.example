# infra/docker-compose.yml 용 환경 변수. 이 파일을 .env 로 복사해 채우세요.
# cp .env.example .env && nano .env

# API 컨테이너 이미지. e2-micro(1GB)에서는 Gradle 빌드가 OOM 나므로
# 로컬/CI 에서 빌드해 레지스트리에 올리고 VM 은 pull 만 한다.
# 예: ghcr.io/<github-user>/jobstudy-api:latest
# 비워 두면 VM 에서 직접 빌드를 시도한다(권장하지 않음).
API_IMAGE=

# DB 비밀번호 (강하게)
DB_PASSWORD=change-me-strong-password

# admin 엔드포인트 보호 토큰 (랜덤 32자: openssl rand -hex 16)
ADMIN_TOKEN=change-me-random-token

# 무료 개인 운영에서는 Claude 관련 값을 비워 둡니다.
ANTHROPIC_API_KEY=
# 카드 생성(야간 배치) — 호출량이 많고 지연시간이 무관해 Sonnet
ANTHROPIC_MODEL=claude-sonnet-5
# 면접 진행(대화형) — 압박 질문 품질이 곧 학습 가치라 Opus
ANTHROPIC_INTERVIEW_MODEL=claude-opus-5
# 면접 비용 통제 — 세션당 턴 상한 + 일일 토큰 캡.
# 공개 배포 시 외부 호출이 그대로 요금이 되므로 반드시 확인할 것.
INTERVIEW_MAX_TURNS=40
INTERVIEW_DAILY_TOKENS=300000

# 프론트(Vercel) 도메인. 배포 후 실제 주소로 교체
CORS_ORIGINS=http://localhost:3000

# 유료 생성/면접 API는 기본 비활성화
GEN_ENABLED=false
INTERVIEW_ENABLED=false
