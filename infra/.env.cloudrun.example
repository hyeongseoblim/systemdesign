# Cloud Run 배포용 환경 변수. 이 파일을 .env.cloudrun 으로 복사해 채운다.
#   cp .env.cloudrun.example .env.cloudrun && nano .env.cloudrun
# (.env.cloudrun 은 .gitignore 대상 — 절대 커밋하지 말 것)

# ── GCP ──────────────────────────────────────────────
# gcloud projects list 로 확인
PROJECT_ID=
# asia-northeast1(도쿄) = 한국에서 RTT ~35ms.
# 무료 티어 리전 적용 범위가 자료마다 엇갈리니 배포 후 결제 리포트를 확인할 것.
# 확실히 무료로만 가려면 us-west1 (RTT ~130ms).
REGION=asia-northeast1
SERVICE=jobstudy-api

# ── DB (Neon) ────────────────────────────────────────
# Neon 대시보드 > Connection Details > "Pooled connection" 의 JDBC 형식.
# 반드시 pooler 엔드포인트(-pooler 가 붙은 호스트)를 쓸 것 — Cloud Run 은
# 인스턴스가 늘었다 줄었다 하므로 직접 연결은 Neon 커넥션 한도를 금방 소진한다.
# 예: jdbc:postgresql://ep-xxx-pooler.ap-southeast-1.aws.neon.tech/jobstudy?sslmode=require
DB_URL=
DB_USER=
DB_PASSWORD=

# ── 앱 ───────────────────────────────────────────────
# admin 엔드포인트 보호 토큰 (openssl rand -hex 16)
ADMIN_TOKEN=
# Claude API 키 (없으면 카드 생성은 스킵되고 앱은 정상 기동)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# 프론트(Vercel) 도메인. 콤마로 여러 개 가능.
CORS_ORIGINS=https://your-app.vercel.app

# 앱 내부 스케줄러는 반드시 false.
# Cloud Run 은 트래픽이 없으면 인스턴스가 0으로 내려가므로 @Scheduled 가 아예 돌지 않는다.
# 대신 .github/workflows/generate.yml 이 매일 admin 엔드포인트를 찌른다.
GEN_ENABLED=false

# Neon 무료 티어 커넥션 한도를 감안한 HikariCP 풀 크기
DB_POOL_MAX=5
DB_POOL_MIN=1
