# Cloud Run + Neon 배포 설정
# cp infra/.env.cloudrun.example infra/.env.cloudrun 후 실제 값을 채우세요.
# 이 파일(.env.cloudrun)은 git에 커밋하지 않습니다.

# gcloud 프로젝트 ID (결제 계정이 연결된 프로젝트)
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-northeast3

# Neon의 "pooled connection" 문자열을 권장합니다.
# 예: jdbc:postgresql://ep-....ap-southeast-1.aws.neon.tech/jobstudy?sslmode=require
# Neon이 제공하는 postgresql:// 문자열은 jdbc:postgresql:// 로 바꿔 넣으세요.
DB_URL=jdbc:postgresql://host/jobstudy?sslmode=require
DB_USER=jobstudy_owner
DB_PASSWORD=change-me

# Vercel 배포 URL. 여러 개면 쉼표로 구분합니다.
CORS_ORIGINS=https://your-app.vercel.app

# 빈 값이면 AI 카드 생성/면접 기능만 사용할 수 없습니다.
ANTHROPIC_API_KEY=
ADMIN_TOKEN=change-me-random-token

# 비용 안전장치
GEN_DAILY_CARDS=1
GEN_DAILY_TOKENS=50000
INTERVIEW_MAX_TURNS=20
INTERVIEW_DAILY_TOKENS=100000
